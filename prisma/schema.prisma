model GeographicObject {
  id                  String                    @id @default(cuid())
  objectType          GeographicObjectType
  canonicalName       String
  displayName         String
  canonicalSlug       String
  lifecycleStatus     GeographicLifecycleStatus @default(DRAFT)
  visibility          GeographicVisibility      @default(INTERNAL_ONLY)
  convenienceParentId String?
  mergedIntoId        String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  convenienceParent     GeographicObject?                @relation("GeographicObjectConvenienceParent", fields: [convenienceParentId], references: [id], onDelete: Restrict)
  convenienceChildren   GeographicObject[]               @relation("GeographicObjectConvenienceParent")
  mergedInto            GeographicObject?                @relation("GeographicObjectSupersession", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedObjects         GeographicObject[]               @relation("GeographicObjectSupersession")
  aliases               GeographicAlias[]
  sourceRelationships   GeographicRelationship[]         @relation("GeographicRelationshipSource")
  targetRelationships   GeographicRelationship[]         @relation("GeographicRelationshipTarget")
  observations          GeographicObservation[]
  eligibility           GeographicEligibility?
  propertyRelationships PropertyGeographicRelationship[]

  @@unique([objectType, canonicalSlug])
  @@index([canonicalSlug])
  @@index([objectType, lifecycleStatus])
  @@index([convenienceParentId])
  @@index([mergedIntoId])
}

model GeographicAlias {
  id              String                    @id @default(cuid())
  objectId        String
  aliasText       String
  normalizedValue String
  aliasType       GeographicAliasType
  language        String?
  sourceId        String?
  lifecycleStatus GeographicLifecycleStatus @default(ACTIVE)
  effectiveDate   DateTime?
  expirationDate  DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  object GeographicObject  @relation(fields: [objectId], references: [id], onDelete: Restrict)
  source GeographicSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([objectId, normalizedValue, aliasType, language, lifecycleStatus], map: "GeographicAlias_objectId_normalizedValue_aliasType_language_lif")
  @@index([normalizedValue])
  @@index([sourceId])
  @@index([lifecycleStatus])
}

model GeographicRelationship {
  id               String                     @id @default(cuid())
  sourceObjectId   String
  targetObjectId   String
  relationshipType GeographicRelationshipType
  directionality   GeographicDirectionality   @default(DIRECTED)
  lifecycleStatus  GeographicLifecycleStatus  @default(ACTIVE)
  sourceId         String?
  confidence       GeographicConfidence       @default(MEDIUM)
  derivationMethod GeographicDerivationMethod @default(MANUAL_REVIEW)
  effectiveDate    DateTime?
  expirationDate   DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  sourceObject GeographicObject  @relation("GeographicRelationshipSource", fields: [sourceObjectId], references: [id], onDelete: Restrict)
  targetObject GeographicObject  @relation("GeographicRelationshipTarget", fields: [targetObjectId], references: [id], onDelete: Restrict)
  source       GeographicSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceObjectId, targetObjectId, relationshipType, directionality, lifecycleStatus], map: "GeographicRelationship_sourceObjectId_targetObjectId_relationsh")
  @@index([sourceObjectId, relationshipType])
  @@index([targetObjectId, relationshipType])
  @@index([sourceId])
}

model GeographicSource {
  id                       String                   @id @default(cuid())
  canonicalName            String                   @unique
  sourceClass              GeographicSourceClass
  authorityLevel           GeographicAuthorityLevel
  accessMethod             GeographicAccessMethod
  coverageDescription      String?
  defaultUpdateCadence     GeographicUpdateCadence  @default(UNKNOWN)
  licensingRestriction     Boolean                  @default(false)
  publicDisplayRestriction Boolean                  @default(true)
  healthState              GeographicHealthState    @default(UNKNOWN)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  aliases               GeographicAlias[]
  relationships         GeographicRelationship[]
  observations          GeographicObservation[]
  propertyRelationships PropertyGeographicRelationship[]

  @@index([sourceClass, authorityLevel])
  @@index([healthState])
}

model GeographicObservation {
  id               String                         @id @default(cuid())
  objectId         String
  observationKey   String
  valueKind        GeographicObservationValueKind
  valueText        String?
  valueNumber      Decimal?
  valueBoolean     Boolean?
  valueDate        DateTime?
  valueJson        Json?
  valueSchemaKey   String?
  sourceId         String?
  effectiveDate    DateTime?
  retrievedAt      DateTime?
  verifiedAt       DateTime?
  freshness        GeographicFreshness            @default(UNKNOWN)
  confidence       GeographicConfidence           @default(MEDIUM)
  derivationMethod GeographicDerivationMethod     @default(SOURCE_REPORTED)
  conflictGroupKey String?
  reviewStatus     GeographicReviewStatus         @default(PENDING_REVIEW)
  publicVisibility GeographicVisibility           @default(INTERNAL_ONLY)
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  object GeographicObject  @relation(fields: [objectId], references: [id], onDelete: Restrict)
  source GeographicSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([objectId, observationKey, effectiveDate])
  @@index([sourceId])
  @@index([conflictGroupKey])
  @@index([reviewStatus])
}

model GeographicEligibility {
  id                 String   @id @default(cuid())
