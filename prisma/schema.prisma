  source           GeographicSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([propertyId, geographicObjectId, relationshipType, lifecycleStatus], map: "PropertyGeographicRelationship_propertyId_geographicObjectId_re")
  @@index([propertyId])
  @@index([geographicObjectId, relationshipType], map: "PropertyGeographicRelationship_geographicObjectId_relationshipT")
  @@index([sourceId])
}

