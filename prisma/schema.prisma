model Property {
  uuid                 String    @id @default(dbgenerated("gen_random_uuid()"))
  id                   String    @unique(map: "Property_id_key") @default(cuid())
  mlsId                String    @unique(map: "property_mlsid_unique_idx")
  slug                 String    @unique(map: "property_slug_idx")
  address              String
  city                 String
  state                String
  zip                  String
  price                Int
  beds                 Float?
  baths                Float?
  sqft                 Int?
  lotSize              Float?
  yearBuilt            Int?
  propertyType         String
  status               String
  lat                  Float
  lng                  Float
  neighborhood         String?
  subdivision          String?
  schoolDistrict       String?
  description          String?
  listingAgent         String?
  listingOffice        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  lastIntelligenceSync DateTime?
  sourceModifiedAt     DateTime?

  publicSearchEligibility PublicSearchEligibility?

  isPrivateExclusive  Boolean @default(false)
  gcForensics         Json?
  negotiationLevers   Json?
  optimizedValue      Int?
  efficiencyScore     Int     @default(0)
  resilienceScore     Int     @default(85)
  altitude            Int     @default(5280)
  soilType            String  @default("Front Range Mixed")
  hasPolybutyleneRisk Boolean @default(false)

  photos                  PropertyPhoto[]
  priceHistory            PriceHistory[]
  openHouses              OpenHouse[]
  alertEvents             AlertEvent[]
  LeadInteraction         LeadInteraction[]
  geographicRelationships PropertyGeographicRelationship[]
  countyIdentityMappings  PropertyCountyIdentityMapping[]
  canonicalListingEvents  CanonicalPropertyListingEvent[]

  @@index([city])
  @@index([status])
  @@index([price])
  @@index([beds])
  @@index([baths])
  @@index([propertyType])
  @@index([lat, lng])
  @@index([publicSearchEligibility])
  @@index([isPrivateExclusive])
  @@index([lastIntelligenceSync])
  @@index([sourceModifiedAt])
}

model PropertySourceIdentity {
  id               String                       @id @default(cuid())
  sourceId         String
  jurisdictionType CountyJurisdictionType
  jurisdictionCode String
  identifierType   PropertySourceIdentifierType
  sourceValue      String
  normalizedValue  String
  status           PropertySourceIdentityStatus @default(OBSERVED)
  firstObservedAt  DateTime?
  lastObservedAt   DateTime?
  validFrom        DateTime?
  validTo          DateTime?
  isCurrent        Boolean                      @default(true)
  supersededById   String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  supersededBy                  PropertySourceIdentity?                          @relation("PropertySourceIdentitySupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes                    PropertySourceIdentity[]                         @relation("PropertySourceIdentitySupersession")
  observations                  PropertySourceIdentityObservation[]
  sourceRelationships           PropertySourceIdentityRelationship[]             @relation("PropertySourceIdentityRelationshipSource")
  targetRelationships           PropertySourceIdentityRelationship[]             @relation("PropertySourceIdentityRelationshipTarget")
  countyIdentityMappings        PropertyCountyIdentityMapping[]
  canonicalPropertyMappings     CanonicalPhysicalPropertySourceIdentityMapping[]
  canonicalPropertyObservations CanonicalPhysicalPropertyObservation[]

  @@unique([sourceId, jurisdictionCode, identifierType, normalizedValue], map: "PSI_source_jurisdiction_type_value_uq")
  @@index([sourceId, jurisdictionCode, identifierType], map: "PSI_source_jurisdiction_type_idx")
  @@index([jurisdictionType, jurisdictionCode, isCurrent], map: "PSI_jurisdiction_current_idx")
  @@index([supersededById], map: "PSI_superseded_idx")
}

model PropertySourceIdentityObservation {
  id                      String                           @id @default(cuid())
  identityId              String
  sourceRecordReference   String?
  fieldSemanticsReference String?
  rightsPostureReference  String?
  attributionReference    String?
  sourcePayloadReference  String?
  freshness               PropertySourceIdentityFreshness  @default(UNKNOWN)
  confidence              PropertySourceIdentityConfidence @default(UNVERIFIED)
  observedAt              DateTime
  ingestedAt              DateTime?
  effectiveAt             DateTime?
  validFrom               DateTime?
  validTo                 DateTime?
  observationFingerprint  String                           @unique(map: "PSIO_fingerprint_uq")
  createdAt               DateTime                         @default(now())

  identity                      PropertySourceIdentity                 @relation(fields: [identityId], references: [id], onDelete: Restrict)
  relationships                 PropertySourceIdentityRelationship[]
  mappings                      PropertyCountyIdentityMapping[]
  canonicalPropertyObservations CanonicalPhysicalPropertyObservation[]

  @@index([identityId, observedAt], map: "PSIO_identity_observed_idx")
  @@index([freshness], map: "PSIO_freshness_idx")
}

model PropertySourceIdentityRelationship {
  id                      String                                   @id @default(cuid())
  sourceIdentityId        String
  targetIdentityId        String
  relationshipType        PropertySourceIdentityRelationshipType
  status                  PropertySourceIdentityRelationshipStatus @default(OBSERVED)
  confidence              PropertySourceIdentityConfidence         @default(UNVERIFIED)
  observationId           String
  effectiveAt             DateTime?
  validFrom               DateTime?
  validTo                 DateTime?
  isCurrent               Boolean                                  @default(true)
  relationshipFingerprint String                                   @unique(map: "PSIR_fingerprint_uq")
  supersededById          String?
  createdAt               DateTime                                 @default(now())
  updatedAt               DateTime                                 @updatedAt

  sourceIdentity PropertySourceIdentity               @relation("PropertySourceIdentityRelationshipSource", fields: [sourceIdentityId], references: [id], onDelete: Restrict)
  targetIdentity PropertySourceIdentity               @relation("PropertySourceIdentityRelationshipTarget", fields: [targetIdentityId], references: [id], onDelete: Restrict)
  observation    PropertySourceIdentityObservation    @relation(fields: [observationId], references: [id], onDelete: Restrict)
  supersededBy   PropertySourceIdentityRelationship?  @relation("PropertySourceIdentityRelationshipSupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes     PropertySourceIdentityRelationship[] @relation("PropertySourceIdentityRelationshipSupersession")

  @@index([sourceIdentityId, relationshipType, isCurrent], map: "PSIR_source_type_current_idx")
  @@index([targetIdentityId, relationshipType, isCurrent], map: "PSIR_target_type_current_idx")
  @@index([observationId], map: "PSIR_observation_idx")
  @@index([supersededById], map: "PSIR_superseded_idx")
}

model PropertyCountyIdentityMapping {
  id                   String                              @id @default(cuid())
  propertyId           String
  identityId           String
  observationId        String?
  status               PropertyCountyIdentityMappingStatus @default(UNMATCHED)
  confidence           PropertySourceIdentityConfidence    @default(UNVERIFIED)
  basis                PropertyCountyIdentityMappingBasis  @default(UNKNOWN)
  verificationRequired Boolean                             @default(true)
  conflictReference    String?
  firstObservedAt      DateTime?
  lastObservedAt       DateTime?
  validFrom            DateTime?
  validTo              DateTime?
  isCurrent            Boolean                             @default(true)
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt

  property    Property                           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  identity    PropertySourceIdentity             @relation(fields: [identityId], references: [id], onDelete: Restrict)
  observation PropertySourceIdentityObservation? @relation(fields: [observationId], references: [id], onDelete: Restrict)

  @@unique([propertyId, identityId], map: "PCIM_property_identity_uq")
  @@index([propertyId, status, isCurrent], map: "PCIM_property_status_current_idx")
  @@index([identityId, status, isCurrent], map: "PCIM_identity_status_current_idx")
  @@index([observationId], map: "PCIM_observation_idx")
}

// Source-independent physical-property anchor. It remains empty until a later
// source-admission and population authorization; legacy Property rows stay listing-shaped.
model CanonicalPhysicalProperty {
  id                          String                                      @id @default(cuid())
  identityStatus              CanonicalPhysicalPropertyIdentityStatus     @default(UNRESOLVED)
  identityConfidence          CanonicalPhysicalPropertyIdentityConfidence @default(UNVERIFIED)
  sourceFormattedSitusAddress String?
  normalizedSitusAddress      String?
  streetNumber                String?
  preDirectional              String?
  streetName                  String?
  streetSuffix                String?
  postDirectional             String?
  unit                        String?
  city                        String?
  state                       String?
  postalCode                  String?
  county                      String?
  jurisdiction                String?
  latitude                    Float?
  longitude                   Float?
  firstObservedAt             DateTime?
  lastObservedAt              DateTime?
  validFrom                   DateTime?
  validTo                     DateTime?
  supersededById              String?
  createdAt                   DateTime                                    @default(now())
  updatedAt                   DateTime                                    @updatedAt

  supersededBy          CanonicalPhysicalProperty?                       @relation("CanonicalPhysicalPropertySupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes            CanonicalPhysicalProperty[]                      @relation("CanonicalPhysicalPropertySupersession")
  sourceMappings        CanonicalPhysicalPropertySourceIdentityMapping[]
  observations          CanonicalPhysicalPropertyObservation[]
  listingEvents         CanonicalPropertyListingEvent[]
  transactions          Transaction[]
  clientCaseProperties  ClientCaseProperty[]
  strategyPropertyRoles StrategyPropertyRole[]
  multiPropertyFinancialScenarioProperties MultiPropertyFinancialScenarioProperty[]

  @@index([identityStatus, identityConfidence], map: "CPP_status_confidence_idx")
  @@index([state, county, jurisdiction], map: "CPP_jurisdiction_idx")
  @@index([normalizedSitusAddress], map: "CPP_normalized_address_idx")
  @@index([supersededById], map: "CPP_superseded_idx")
}

model CanonicalPhysicalPropertySourceIdentityMapping {
  id                   String                                      @id @default(cuid())
  canonicalPropertyId  String
  identityId           String
  associationType      CanonicalPhysicalPropertyAssociationType
  status               CanonicalPhysicalPropertyAssociationStatus  @default(OBSERVED)
  confidence           CanonicalPhysicalPropertyIdentityConfidence @default(UNVERIFIED)
  basis                CanonicalPhysicalPropertyAssociationBasis   @default(UNKNOWN)
  verificationRequired Boolean                                     @default(true)
  conflictReference    String?
  firstObservedAt      DateTime?
  lastObservedAt       DateTime?
  validFrom            DateTime?
  validTo              DateTime?
  isCurrent            Boolean                                     @default(true)
