datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Property {
  id                   String    @id @default(cuid())
  mlsId                String    @unique
  slug                 String    @unique
  address              String
  city                 String
  state                String
  zip                  String
  price                Int
  beds                 Float?
  baths                Float?
  sqft                 Int?
  lotSize              Float?
  yearBuilt            Int?
  propertyType         String
  status               String
  lat                  Float
  lng                  Float
  neighborhood         String?
  subdivision          String?
  schoolDistrict       String?
  description          String?
  listingAgent         String?
  listingOffice        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  lastIntelligenceSync DateTime?

  isPrivateExclusive  Boolean @default(false)
  gcForensics         Json?
  negotiationLevers   Json?
  optimizedValue      Int?
  efficiencyScore     Int     @default(0)
  resilienceScore     Int     @default(85)
  altitude            Int     @default(5280)
  soilType            String  @default("Front Range Mixed")
  hasPolybutyleneRisk Boolean @default(false)

  photos                  PropertyPhoto[]
  priceHistory            PriceHistory[]
  openHouses              OpenHouse[]
  alertEvents             AlertEvent[]
  LeadInteraction         LeadInteraction[]
  geographicRelationships PropertyGeographicRelationship[]

  @@index([city])
  @@index([status])
  @@index([price])
  @@index([beds])
  @@index([baths])
  @@index([propertyType])
  @@index([lat, lng])
  @@index([isPrivateExclusive])
  @@index([lastIntelligenceSync])
}

model MlsSyncState {
  id                   Int       @id @default(1)
  lastSync             DateTime  @default(now())
  lastIntelligenceSync DateTime?
  lastPage             Int       @default(0)
  totalRecords         Int       @default(0)
  isSyncing            Boolean   @default(false)
}

model REIEControlState {
  key       String   @id
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  order      Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PriceHistory {
  id         String   @id @default(cuid())
  propertyId String
  price      Int
  event      String
  date       DateTime
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([date])
}

model OpenHouse {
  id         String   @id @default(cuid())
  propertyId String
  startTime  DateTime
  endTime    DateTime
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([startTime])
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  isUnsubscribed Boolean   @default(false)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  status           String  @default("Lead")
  hasPrivateAccess Boolean @default(false)
  heatScore        Int     @default(0)
  aestheticTag     String?
  intentSchema     String?
  legacyGoal       String?

  searches          SavedSearch[]
  alertEvents       AlertEvent[]
  alertQueue        AlertQueue[]
  crmTasks          CRMTask[]
  interactions      UserInteraction[]
  leadInteractions  LeadInteraction[]
  northStars        NorthStar[]
  preferences       UserPreference?
  unsubscribeTokens UnsubscribeToken[]
  emailLogs         EmailLog[]
}

model CRMTask {
  id           String      @id @default(cuid())
  leadId       String
  user         User        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sellerLeadId String?     @map("leadid") @db.Uuid
  sellerLead   SellerLead? @relation(fields: [sellerLeadId], references: [id], onDelete: Cascade)
  type         String
  status       String      @default("pending")
  priority     String      @default("medium")
  title        String
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([leadId])
  @@index([sellerLeadId])
  @@index([type, createdAt])
  @@index([status, type, createdAt])
}

model UserInteraction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  duration  Int?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type, createdAt])
}

model LeadInteraction {
  id              String   @id @default(cuid())
  clientId        String
  propertyId      String
  interactionType String
  metadata        Json?
  createdAt       DateTime @default(now())

  user     User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([propertyId])
  @@index([interactionType])
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avgPrice  Int?
  avgBeds   Int?
  topCities String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NorthStar {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  address   String
  lat       Float?
  lng       Float?
  type      String
  frequency Int    @default(5)
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      String
  minPrice  Int?
  beds      Int?
  type      String?
  north     Float?
  south     Float?
  east      Float?
  west      Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  unsubscribeTokens UnsubscribeToken[]
}

model AlertEvent {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  type       String
  sentAt     DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])

  @@unique([userId, propertyId, type])
}

model AlertQueue {
  id        String    @id @default(cuid())
  userId    String
  status    String    @default("pending")
  payload   Json?
  clickedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([clickedAt])
}

model SellerLead {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city       String
  beds       Int?
  price      Int?
  reason     String
  propertyId String
  crmTasks   CRMTask[]
}

model UnsubscribeToken {
  id        String       @id @default(cuid())
  token     String       @unique
  userId    String
  searchId  String?
  createdAt DateTime     @default(now())
  usedAt    DateTime?
  user      User         @relation(fields: [userId], references: [id])
  search    SavedSearch? @relation(fields: [searchId], references: [id], onDelete: SetNull)
}

model EmailLog {
  id      String   @id @default(cuid())
  userId  String
  subject String
  type    String
  sentAt  DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model City {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  state         String         @default("CO")
  neighborhoods Neighborhood[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Neighborhood {
  id                  String   @id @default(cuid())
  cityId              String
  city                City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name                String
  slug                String
  avgEfficiencyScore  Int      @default(0)
  primaryAnchor       String
  lifestyleVibe       String
  era                 String?
  resilienceScore     Int      @default(0)
  altitude            Int?
  soilType            String?
  fireRisk            String?
  insuranceComplexity String?
  waterRights         Boolean?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([cityId, slug])
  @@index([slug])
}

enum GeographicObjectType {
  STATE
  MUNICIPALITY
  NEIGHBORHOOD
  MARKET_AREA
  ZIP_CODE
  SUBDIVISION
}

enum GeographicLifecycleStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  MERGED
  ARCHIVED
}

enum GeographicVisibility {
  INTERNAL_ONLY
  PUBLIC_ELIGIBLE
}

enum GeographicAliasType {
  PRIMARY
  COMMON
  LEGAL
  MLS
  LEGACY
}

enum GeographicRelationshipType {
  CONTAINS
  WITHIN
  OVERLAPS
  ADJACENT_TO
  SUPERSEDES
  RELATED_MARKET
}

enum GeographicDirectionality {
  DIRECTED
  BIDIRECTIONAL
}

enum GeographicSourceClass {
  INTERNAL
  GOVERNMENT
  MLS
  MANUAL_RESEARCH
  DERIVED
}

enum GeographicAuthorityLevel {
  AUTHORITATIVE
  SUPPORTING
  INFORMATIVE
  UNVERIFIED
}

enum GeographicAccessMethod {
  MANUAL
  PUBLIC_WEB
  API
  FILE_IMPORT
  INTERNAL_DERIVATION
}

enum GeographicUpdateCadence {
  STATIC
  ANNUAL
  QUARTERLY
  MONTHLY
  EVENT_DRIVEN
  UNKNOWN
}

enum GeographicHealthState {
  READY
  WATCH
  DEGRADED
  BLOCKED
  UNKNOWN
}

enum GeographicConfidence {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT
}

enum GeographicObservationValueKind {
  TEXT
  NUMBER
  BOOLEAN
  JSON
  DATE
}

enum GeographicFreshness {
  FRESH
  AGING
  STALE
  UNKNOWN
  NOT_APPLICABLE
}

enum GeographicDerivationMethod {
  SOURCE_REPORTED
  MANUAL_REVIEW
  INTERNAL_DERIVED
  CROSS_SOURCE_RECONCILED
}

enum GeographicReviewStatus {
  PENDING_REVIEW
  REVIEWED
  CONFLICTED
  REJECTED
}

enum GeographicPropertyRelationshipType {
  LOCATED_IN
  MARKETED_AS
  SERVED_BY
  NEAR
}

model GeographicObject {
  id                  String                    @id @default(cuid())
  objectType          GeographicObjectType
  canonicalName       String
  displayName         String
  canonicalSlug       String
  lifecycleStatus     GeographicLifecycleStatus @default(DRAFT)
  visibility          GeographicVisibility      @default(INTERNAL_ONLY)
  convenienceParentId String?
  mergedIntoId        String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  convenienceParent     GeographicObject?                @relation("GeographicObjectConvenienceParent", fields: [convenienceParentId], references: [id], onDelete: Restrict)
  convenienceChildren   GeographicObject[]               @relation("GeographicObjectConvenienceParent")
  mergedInto            GeographicObject?                @relation("GeographicObjectSupersession", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedObjects         GeographicObject[]               @relation("GeographicObjectSupersession")
  aliases               GeographicAlias[]
  sourceRelationships   GeographicRelationship[]         @relation("GeographicRelationshipSource")
  targetRelationships   GeographicRelationship[]         @relation("GeographicRelationshipTarget")
  observations          GeographicObservation[]
  eligibility           GeographicEligibility?
  propertyRelationships PropertyGeographicRelationship[]

  @@unique([objectType, canonicalSlug])
  @@index([canonicalSlug])
  @@index([objectType, lifecycleStatus])
  @@index([convenienceParentId])
  @@index([mergedIntoId])
}

model GeographicAlias {
  id              String                    @id @default(cuid())
  objectId        String
  aliasText       String
  normalizedValue String
  aliasType       GeographicAliasType
  language        String?
  sourceId        String?
  lifecycleStatus GeographicLifecycleStatus @default(ACTIVE)
  effectiveDate   DateTime?
  expirationDate  DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  object GeographicObject  @relation(fields: [objectId], references: [id], onDelete: Restrict)
  source GeographicSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([objectId, normalizedValue, aliasType, language, lifecycleStatus])
  @@index([normalizedValue])
  @@index([sourceId])
  @@index([lifecycleStatus])
}

model GeographicRelationship {
  id               String                     @id @default(cuid())
  sourceObjectId   String
  targetObjectId   String
  relationshipType GeographicRelationshipType
  directionality   GeographicDirectionality   @default(DIRECTED)
  lifecycleStatus  GeographicLifecycleStatus  @default(ACTIVE)
  sourceId         String?
  confidence       GeographicConfidence       @default(MEDIUM)
  derivationMethod GeographicDerivationMethod @default(MANUAL_REVIEW)
  effectiveDate    DateTime?
  expirationDate   DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  sourceObject GeographicObject  @relation("GeographicRelationshipSource", fields: [sourceObjectId], references: [id], onDelete: Restrict)
  targetObject GeographicObject  @relation("GeographicRelationshipTarget", fields: [targetObjectId], references: [id], onDelete: Restrict)
  source       GeographicSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceObjectId, targetObjectId, relationshipType, directionality, lifecycleStatus])
  @@index([sourceObjectId, relationshipType])
  @@index([targetObjectId, relationshipType])
  @@index([sourceId])
}

model GeographicSource {
  id                       String                   @id @default(cuid())
  canonicalName            String                   @unique
  sourceClass              GeographicSourceClass
  authorityLevel           GeographicAuthorityLevel
  accessMethod             GeographicAccessMethod
  coverageDescription      String?
  defaultUpdateCadence     GeographicUpdateCadence  @default(UNKNOWN)
  licensingRestriction     Boolean                  @default(false)
  publicDisplayRestriction Boolean                  @default(true)
  healthState              GeographicHealthState    @default(UNKNOWN)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  aliases               GeographicAlias[]
  relationships         GeographicRelationship[]
  observations          GeographicObservation[]
  propertyRelationships PropertyGeographicRelationship[]

  @@index([sourceClass, authorityLevel])
  @@index([healthState])
}

model GeographicObservation {
  id               String                         @id @default(cuid())
  objectId         String
  observationKey   String
  valueKind        GeographicObservationValueKind
  valueText        String?
  valueNumber      Decimal?
  valueBoolean     Boolean?
  valueDate        DateTime?
  valueJson        Json?
  valueSchemaKey   String?
  sourceId         String?
  effectiveDate    DateTime?
  retrievedAt      DateTime?
  verifiedAt       DateTime?
  freshness        GeographicFreshness            @default(UNKNOWN)
  confidence       GeographicConfidence           @default(MEDIUM)
  derivationMethod GeographicDerivationMethod     @default(SOURCE_REPORTED)
  conflictGroupKey String?
  reviewStatus     GeographicReviewStatus         @default(PENDING_REVIEW)
  publicVisibility GeographicVisibility           @default(INTERNAL_ONLY)
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  object GeographicObject  @relation(fields: [objectId], references: [id], onDelete: Restrict)
  source GeographicSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([objectId, observationKey, effectiveDate])
  @@index([sourceId])
  @@index([conflictGroupKey])
  @@index([reviewStatus])
}

model GeographicEligibility {
  id                 String   @id @default(cuid())
  objectId           String   @unique
  internalUse        Boolean  @default(false)
  searchEligible     Boolean  @default(false)
  mapEligible        Boolean  @default(false)
  publicPageEligible Boolean  @default(false)
  indexingEligible   Boolean  @default(false)
  propertyEnrichment Boolean  @default(false)
  marketAnalytics    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  object GeographicObject @relation(fields: [objectId], references: [id], onDelete: Restrict)
}

model PropertyGeographicRelationship {
  id                 String                             @id @default(cuid())
  propertyId         String
  geographicObjectId String
  relationshipType   GeographicPropertyRelationshipType
  sourceId           String?
  confidence         GeographicConfidence               @default(MEDIUM)
  assignmentMethod   GeographicDerivationMethod         @default(MANUAL_REVIEW)
  effectiveDate      DateTime?
  expirationDate     DateTime?
  lifecycleStatus    GeographicLifecycleStatus          @default(ACTIVE)
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt

  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  geographicObject GeographicObject  @relation(fields: [geographicObjectId], references: [id], onDelete: Restrict)
  source           GeographicSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([propertyId, geographicObjectId, relationshipType, lifecycleStatus])
  @@index([propertyId])
  @@index([geographicObjectId, relationshipType])
  @@index([sourceId])
}

enum EIAEnvironment {
  PRODUCTION
  PREVIEW
  DEVELOPMENT
  TEST
  UNKNOWN
}

enum EIADataOrigin {
  LIVE
  FIXTURE
  MANUAL
  IMPORTED
  UNKNOWN
}

enum EIAConfidence {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT
}

enum EIAFreshness {
  FRESH
  AGING
  STALE
  UNKNOWN
  NOT_APPLICABLE
}

enum EIAPrivacy {
  INTERNAL
  EXECUTIVE
  SYSTEM
}

enum EIASensitivity {
  PUBLIC_SAFE
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum EIAPii {
  NONE
  PSEUDONYMOUS
  AGGREGATED
  PERSONAL
}

enum EIARetention {
  HISTORICAL
  OPERATIONAL
  AUDIT
  TEMPORARY
}

enum EIAImmutability {
  APPEND_ONLY
  IMMUTABLE_VERSIONED
  MUTABLE_WITH_HISTORY
  REFERENCE_DATA
}

enum EIAValueKind {
  NUMERIC
  TEXT
  BOOLEAN
  RATIO
  DURATION
  UNAVAILABLE
}

enum EIAKpiStatus {
  HEALTHY
  WARNING
  CRITICAL
  UNKNOWN
  NOT_APPLICABLE
}

enum EIAHealthClassification {
  HEALTHY
  WATCH
  DEGRADED
  BLOCKED
  UNKNOWN
}

enum EIASignalKind {
  RISK
  OPPORTUNITY
}

enum EIADispositionKind {
  APPROVE
  REJECT
  DEFER
  REVISE
  REQUEST_MORE_EVIDENCE
  OVERRIDE_RECOMMENDATION
  NO_DECISION
}

enum EIAWorkflowState {
  PROPOSED
  APPROVED
  PLANNED
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
  UNDER_REVIEW
  NEEDS_REVIEW
  DEFERRED
  REJECTED
  ARCHIVED
}

model EIAProvenance {
  id                 String          @id @default(cuid())
  sourceSystem       String
  sourceType         String
  sourceRecordId     String?
  sourceQueryRef     String?
  observationAt      DateTime?
  ingestedAt         DateTime        @default(now())
  processedAt        DateTime?
  environment        EIAEnvironment
  dataOrigin         EIADataOrigin
  fixtureSet         String?
  fixtureScenario    String?
  calculationVersion String?
  schemaVersion      String
  domainModelVersion String?
  canonVersion       String?
  repositoryVersion  String?
  confidence         EIAConfidence
  freshness          EIAFreshness
  privacy            EIAPrivacy
  sensitivity        EIASensitivity
  pii                EIAPii          @default(NONE)
  retention          EIARetention
  creatingService    String
  creatingAppVersion String?
  supersedesId       String?
  correctionOfId     String?
  immutability       EIAImmutability @default(APPEND_ONLY)
  createdAt          DateTime        @default(now())
  archivedAt         DateTime?

  supersedes   EIAProvenance?  @relation("EIAProvenanceSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy EIAProvenance[] @relation("EIAProvenanceSupersession")
  correctionOf EIAProvenance?  @relation("EIAProvenanceCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections  EIAProvenance[] @relation("EIAProvenanceCorrection")

  evidenceReferences    EIAEvidenceReference[]
  kpiObservations       EIAKpiObservation[]
  kpiEvaluations        EIAKpiEvaluation[]
  thresholdEvaluations  EIAKpiThresholdEvaluation[]
  kpiTransitions        EIAKpiTransition[]
  healthSnapshots       EIAEnterpriseHealthSnapshot[]
  domainHealthSnapshots EIADomainHealthSnapshot[]
  healthContributions   EIAHealthContribution[]
  intelligenceEvents    EIAIntelligenceEvent[]
  intelligenceSignals   EIAIntelligenceSignal[]
  executiveInsights     EIAExecutiveInsight[]
  decisionSituations    EIADecisionSituation[]
  decisionPackages      EIADecisionPackage[]
  decisionOptions       EIADecisionOption[]
  decisionScores        EIADecisionScore[]
  recommendations       EIADecisionRecommendation[]
  dispositions          EIADecisionDisposition[]
  initiatives           EIAEnterpriseInitiative[]
  initiativeStatuses    EIAInitiativeStatusHistory[]
  baselines             EIAInitiativeBaseline[]
  expectedOutcomes      EIAExpectedOutcome[]
  outcomeObservations   EIAOutcomeObservation[]
  outcomeVariances      EIAOutcomeVariance[]
  initiativeReviews     EIAInitiativeReview[]
  decisionEvaluations   EIADecisionEvaluation[]
  recommendationEvals   EIARecommendationEvaluation[]
  lessons               EIALessonLearned[]
  improvementActions    EIAImprovementAction[]
  actionStatuses        EIAImprovementActionStatusHistory[]
  backlogItems          EIAContinuousImprovementBacklogItem[]

  @@index([sourceSystem, sourceRecordId])
  @@index([environment, dataOrigin])
  @@index([fixtureSet, fixtureScenario])
  @@index([calculationVersion])
  @@index([createdAt])
  @@index([supersedesId])
  @@index([correctionOfId])
}

model EIAEvidenceReference {
  id                  String          @id @default(cuid())
  evidenceKey         String          @unique
  evidenceType        String
  title               String
  sourceSystem        String
  sourceRecordId      String?
  sourceQueryRef      String?
  observedAt          DateTime?
  repositoryObjectRid String?
  contentHash         String?
  provenanceId        String
  environment         EIAEnvironment
  dataOrigin          EIADataOrigin
  confidence          EIAConfidence
  freshness           EIAFreshness
  privacy             EIAPrivacy
  sensitivity         EIASensitivity
  pii                 EIAPii          @default(NONE)
  retention           EIARetention
  immutability        EIAImmutability @default(APPEND_ONLY)
  createdAt           DateTime        @default(now())
  archivedAt          DateTime?
  supersedesId        String?

  provenance   EIAProvenance          @relation(fields: [provenanceId], references: [id], onDelete: Restrict)
  supersedes   EIAEvidenceReference?  @relation("EIAEvidenceSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy EIAEvidenceReference[] @relation("EIAEvidenceSupersession")
  links        EIAEvidenceLink[]

  @@index([provenanceId])
  @@index([evidenceType])
  @@index([repositoryObjectRid])
  @@index([environment, dataOrigin])
  @@index([supersedesId])
}

model EIAEvidenceLink {
  id           String   @id @default(cuid())
  evidenceId   String
  entityType   String
  entityId     String
  relationship String
  createdAt    DateTime @default(now())

  evidence EIAEvidenceReference @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([evidenceId, entityType, entityId, relationship])
  @@index([entityType, entityId])
  @@index([evidenceId])
}

model EIAKpiObservation {
  id                 String          @id @default(cuid())
  kpiId              String
  valueKind          EIAValueKind
  numericValue       Decimal?
  textValue          String?
  booleanValue       Boolean?
  ratioNumerator     Decimal?
  ratioDenominator   Decimal?
  durationMs         Int?
  unavailableReason  String?
  unit               String?
  periodStart        DateTime?
  periodEnd          DateTime?
  observedAt         DateTime?
  status             EIAKpiStatus
  idempotencyKey     String          @unique
  calculationVersion String
  schemaVersion      String
  provenanceId       String
  environment        EIAEnvironment
  dataOrigin         EIADataOrigin
  fixtureSet         String?
  fixtureScenario    String?
  confidence         EIAConfidence
  freshness          EIAFreshness
  privacy            EIAPrivacy
  sensitivity        EIASensitivity
  retention          EIARetention
  immutability       EIAImmutability @default(APPEND_ONLY)
  createdAt          DateTime        @default(now())
  archivedAt         DateTime?
  supersedesId       String?

  provenance          EIAProvenance           @relation(fields: [provenanceId], references: [id], onDelete: Restrict)
  supersedes          EIAKpiObservation?      @relation("EIAKpiObservationSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy        EIAKpiObservation[]     @relation("EIAKpiObservationSupersession")
  evaluations         EIAKpiEvaluation[]
  transitionsPrevious EIAKpiTransition[]      @relation("EIAKpiTransitionPreviousObservation")
