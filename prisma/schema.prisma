  initiative          EIAEnterpriseInitiative       @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  provenance          EIAProvenance                 @relation(fields: [provenanceId], references: [id], onDelete: Restrict)
  decisionEvaluations EIADecisionEvaluation[]
  recommendationEvals EIARecommendationEvaluation[]
  lessons             EIALessonLearned[]

  @@index([initiativeId, reviewAt])
}

model EIADecisionEvaluation {
  id               String          @id @default(cuid())
  evaluationKey    String          @unique
  initiativeId     String
  packageId        String?
  reviewId         String?
  result           String
  outcomeQuality   String
  evidenceCoverage Decimal?
  explanation      String
  authorAuthority  String
  reviewAt         DateTime
  provenanceId     String
  confidence       EIAConfidence
  immutability     EIAImmutability @default(APPEND_ONLY)
  createdAt        DateTime        @default(now())

  initiative EIAEnterpriseInitiative @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  package    EIADecisionPackage?     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  review     EIAInitiativeReview?    @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  provenance EIAProvenance           @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@index([initiativeId])
  @@index([packageId])
  @@index([reviewId])
}

model EIARecommendationEvaluation {
  id                      String          @id @default(cuid())
  evaluationKey           String          @unique
  initiativeId            String
  packageId               String?
  recommendationId        String?
  reviewId                String?
  calibrationFinding      String
  outcomeAchieved         String
  causalityClassification String
  authorAuthority         String
  reviewAt                DateTime
  provenanceId            String
  confidence              EIAConfidence
  immutability            EIAImmutability @default(APPEND_ONLY)
  createdAt               DateTime        @default(now())

  initiative     EIAEnterpriseInitiative    @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  package        EIADecisionPackage?        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  recommendation EIADecisionRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: Restrict)
  review         EIAInitiativeReview?       @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  provenance     EIAProvenance              @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@index([initiativeId])
  @@index([packageId])
  @@index([recommendationId])
  @@index([reviewId])
}

model EIALessonLearned {
  id                      String          @id @default(cuid())
  lessonKey               String          @unique
  title                   String
  summary                 String
  lessonType              String
  initiativeId            String?
  reviewId                String?
  causalityClassification String
  authorAuthority         String
  reviewAt                DateTime
  provenanceId            String
  confidence              EIAConfidence
  privacy                 EIAPrivacy      @default(EXECUTIVE)
  sensitivity             EIASensitivity
  retention               EIARetention
  immutability            EIAImmutability @default(APPEND_ONLY)
  createdAt               DateTime        @default(now())
  archivedAt              DateTime?
  supersedesId            String?

  initiative         EIAEnterpriseInitiative? @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  review             EIAInitiativeReview?     @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  provenance         EIAProvenance            @relation(fields: [provenanceId], references: [id], onDelete: Restrict)
  supersedes         EIALessonLearned?        @relation("EIALessonSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy       EIALessonLearned[]       @relation("EIALessonSupersession")
  improvementActions EIAImprovementAction[]

  @@index([initiativeId])
  @@index([reviewId])
  @@index([lessonType])
  @@index([supersedesId])
}

model EIAImprovementAction {
  id                String           @id @default(cuid())
  actionKey         String           @unique
  title             String
  description       String
  lessonId          String?
  initiativeId      String?
  ownerRole         String?
  priority          String
  currentState      EIAWorkflowState
  suggestedReviewAt DateTime?
  provenanceId      String
  confidence        EIAConfidence
  privacy           EIAPrivacy       @default(EXECUTIVE)
  sensitivity       EIASensitivity
  retention         EIARetention
  immutability      EIAImmutability  @default(MUTABLE_WITH_HISTORY)
  createdAt         DateTime         @default(now())
  archivedAt        DateTime?

  lesson        EIALessonLearned?                     @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  initiative    EIAEnterpriseInitiative?              @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  provenance    EIAProvenance                         @relation(fields: [provenanceId], references: [id], onDelete: Restrict)
  statusHistory EIAImprovementActionStatusHistory[]
  backlogItems  EIAContinuousImprovementBacklogItem[]

  @@index([lessonId])
  @@index([initiativeId])
  @@index([currentState, priority])
}

model EIAImprovementActionStatusHistory {
  id           String            @id @default(cuid())
  actionId     String
  fromState    EIAWorkflowState?
  toState      EIAWorkflowState
  changedAt    DateTime          @default(now())
  changedBy    String
  reason       String
  provenanceId String
  immutability EIAImmutability   @default(APPEND_ONLY)

  action     EIAImprovementAction @relation(fields: [actionId], references: [id], onDelete: Restrict)
  provenance EIAProvenance        @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@index([actionId, changedAt])
  @@index([toState])
}

model EIAContinuousImprovementBacklogItem {
  id              String           @id @default(cuid())
  backlogKey      String           @unique
  actionId        String
  rank            Int?
  criteriaVersion String
  totalScore      Decimal?
  status          EIAWorkflowState @default(NEEDS_REVIEW)
  provenanceId    String
  immutability    EIAImmutability  @default(MUTABLE_WITH_HISTORY)
  createdAt       DateTime         @default(now())
  archivedAt      DateTime?

  action     EIAImprovementAction @relation(fields: [actionId], references: [id], onDelete: Restrict)
  provenance EIAProvenance        @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@index([actionId])
  @@index([rank])
  @@index([status])
}

// prisma/schema.prisma
