  alternative StrategyAlternative @relation(fields: [alternativeId], references: [id], onDelete: Restrict)

  @@unique([alternativeId, upstreamArtifact, dependencyType], map: "StrategyAlternativeDependency_alternativeId_upstreamArtifact_de")
  @@index([ownerAgentSubject, alternativeId], map: "StrategyAlternativeDependency_ownerAgentSubject_alternativeId_i")
}

model StrategyAlternativeAuditEvent {
  id                String   @id @default(cuid())
  alternativeId     String
  ownerAgentSubject String
  eventType         String
  eventFingerprint  String   @unique
  createdAt         DateTime @default(now())

  alternative StrategyAlternative @relation(fields: [alternativeId], references: [id], onDelete: Restrict)

  @@index([alternativeId, createdAt])
  @@index([ownerAgentSubject, createdAt])
}

// Canonical durable root for coordinated sell, retain, replacement, and investment
// scenarios. Existing seller, investment, and strategy records remain specialized
// analysis families and are not repurposed as this root.
model MultiPropertyFinancialScenario {
  id                String                                       @id @default(cuid())
  ownerAgentSubject String
  clientCaseId      String?
  scenarioKey       String
  displayName       String
  lifecycleState    MultiPropertyFinancialScenarioLifecycleState @default(ACTIVE)
  createdBySubject  String
  createdAt         DateTime                                     @default(now())
  archivedAt        DateTime?

  clientCase  ClientCase?                                @relation(fields: [clientCaseId], references: [id], onDelete: SetNull)
  versions    MultiPropertyFinancialScenarioVersion[]
  auditEvents MultiPropertyFinancialScenarioAuditEvent[]

  @@unique([ownerAgentSubject, scenarioKey], map: "MultiPropertyFinancialScenario_ownerAgentSubject_scenarioKey_ke")
  @@index([ownerAgentSubject, clientCaseId, createdAt], map: "MultiPropertyFinancialScenario_ownerAgentSubject_clientCaseId_c")
  @@index([ownerAgentSubject, lifecycleState, createdAt], map: "MultiPropertyFinancialScenario_ownerAgentSubject_lifecycleState")
}

model MultiPropertyFinancialScenarioVersion {
  id                  String   @id @default(cuid())
  scenarioId          String
  ownerAgentSubject   String
  versionOrdinal      Int
  schemaVersion       String
  calculationEngine   String
  inputSnapshot       Json
  inputFingerprint    String   @unique
  idempotencyKey      String   @unique
  supersedesVersionId String?  @unique
  createdBySubject    String
  createdAt           DateTime @default(now())

  scenario          MultiPropertyFinancialScenario             @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  properties        MultiPropertyFinancialScenarioProperty[]
  result            MultiPropertyFinancialScenarioResult?
  outputVersions    OutputVersion[]
  supersedesVersion MultiPropertyFinancialScenarioVersion?     @relation("MultiPropertyFinancialScenarioVersionSupersession", fields: [supersedesVersionId], references: [id], onDelete: Restrict)
  supersededBy      MultiPropertyFinancialScenarioVersion?     @relation("MultiPropertyFinancialScenarioVersionSupersession")
  auditEvents       MultiPropertyFinancialScenarioAuditEvent[]

  @@unique([scenarioId, versionOrdinal], map: "MultiPropertyFinancialScenarioVersion_scenarioId_versionOrdinal")
  @@index([ownerAgentSubject, scenarioId, createdAt], map: "MultiPropertyFinancialScenarioVersion_ownerAgentSubject_scenari")
}

model MultiPropertyFinancialScenarioProperty {
  id                  String                                              @id @default(cuid())
  scenarioVersionId   String
  canonicalPropertyId String?
  ownerAgentSubject   String
  sequence            Int
  role                MultiPropertyFinancialScenarioPropertyRole
  referenceType       MultiPropertyFinancialScenarioPropertyReferenceType
  displayLabel        String
  inputSnapshot       Json
  provenanceSnapshot  Json
  createdAt           DateTime                                            @default(now())

  scenarioVersion   MultiPropertyFinancialScenarioVersion @relation(fields: [scenarioVersionId], references: [id], onDelete: Restrict)
  canonicalProperty CanonicalPhysicalProperty?            @relation(fields: [canonicalPropertyId], references: [id], onDelete: SetNull)

  @@unique([scenarioVersionId, sequence], map: "MultiPropertyFinancialScenarioProperty_scenarioVersionId_sequen")
  @@index([ownerAgentSubject, canonicalPropertyId], map: "MultiPropertyFinancialScenarioProperty_ownerAgentSubject_canoni")
  @@index([scenarioVersionId, role], map: "MultiPropertyFinancialScenarioProperty_scenarioVersionId_role_i")
}

model MultiPropertyFinancialScenarioResult {
  id                  String   @id @default(cuid())
  scenarioVersionId   String   @unique
  ownerAgentSubject   String
  schemaVersion       String
  calculationEngine   String
  inputFingerprint    String
  resultSnapshot      Json
  resultFingerprint   String   @unique
  calculatedBySubject String
  calculatedAt        DateTime @default(now())
  immutableAt         DateTime @default(now())

  scenarioVersion MultiPropertyFinancialScenarioVersion @relation(fields: [scenarioVersionId], references: [id], onDelete: Restrict)

  @@index([ownerAgentSubject, calculatedAt], map: "MultiPropertyFinancialScenarioResult_ownerAgentSubject_calculat")
  @@index([inputFingerprint])
}

model MultiPropertyFinancialScenarioAuditEvent {
  id                String   @id @default(cuid())
  scenarioId        String
  scenarioVersionId String?
  ownerAgentSubject String
  eventType         String
  eventFingerprint  String   @unique
  detail            Json
  createdAt         DateTime @default(now())

  scenario        MultiPropertyFinancialScenario         @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  scenarioVersion MultiPropertyFinancialScenarioVersion? @relation(fields: [scenarioVersionId], references: [id], onDelete: Restrict)

  @@index([scenarioId, createdAt], map: "MultiPropertyFinancialScenarioAuditEvent_scenarioId_createdAt_i")
  @@index([ownerAgentSubject, createdAt], map: "MultiPropertyFinancialScenarioAuditEvent_ownerAgentSubject_crea")
}

model AdvancedInvestmentReturnAnalysis {
  id                 String   @id @default(cuid())
  ownerAgentSubject  String
  analysisKey        String
  title              String
  purpose            String
  lifecycleState     String
  calculationVersion String
  projectionPolicy   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  projections AdvancedInvestmentReturnProjection[]

  @@unique([ownerAgentSubject, analysisKey], map: "AdvancedInvestmentReturnAnalysis_ownerAgentSubject_analysisKey_")
  @@index([ownerAgentSubject, createdAt], map: "AdvancedInvestmentReturnAnalysis_ownerAgentSubject_createdAt_id")
}

model AdvancedInvestmentReturnProjection {
  id                     String    @id @default(cuid())
  analysisId             String
  ownerAgentSubject      String
  projectionKey          String
  versionOrdinal         Int
  analysisProfile        String
  sourceKind             String
  sourceArtifactId       String
  sourceResultId         String
  sourceInputFingerprint String
  lifecycleState         String
  calculationVersion     String
  projectionPolicy       String
  selectedHorizonMonths  Json
  inputSnapshot          Json
  assumptionSnapshot     Json
  dependencySnapshot     Json
  inputFingerprint       String    @unique
  supersedesProjectionId String?   @unique
  createdAt              DateTime  @default(now())
  reviewedAt             DateTime?

  analysis               AdvancedInvestmentReturnAnalysis           @relation(fields: [analysisId], references: [id], onDelete: Restrict)
  results                AdvancedInvestmentReturnProjectionResult[]
  dependencies           AdvancedInvestmentReturnDependency[]
  auditEvents            AdvancedInvestmentReturnAuditEvent[]
  supersedesProjection   AdvancedInvestmentReturnProjection?        @relation("AdvancedInvestmentReturnProjectionSupersession", fields: [supersedesProjectionId], references: [id], onDelete: Restrict)
  supersededByProjection AdvancedInvestmentReturnProjection?        @relation("AdvancedInvestmentReturnProjectionSupersession")

  @@unique([analysisId, projectionKey, versionOrdinal], map: "AdvancedInvestmentReturnProjection_analysisId_projectionKey_ver")
  @@index([ownerAgentSubject, analysisId, createdAt], map: "AdvancedInvestmentReturnProjection_ownerAgentSubject_analysisId")
}

model AdvancedInvestmentReturnProjectionResult {
  id                 String   @id @default(cuid())
  projectionId       String
  ownerAgentSubject  String
  inputFingerprint   String
  calculationVersion String
  projectionPolicy   String
  versionOrdinal     Int
  resultSnapshot     Json
  resultFingerprint  String   @unique
  createdAt          DateTime @default(now())
  immutableAt        DateTime @default(now())

  projection AdvancedInvestmentReturnProjection @relation(fields: [projectionId], references: [id], onDelete: Restrict)

  @@unique([projectionId, versionOrdinal], map: "AdvancedInvestmentReturnProjectionResult_projectionId_versionOr")
  @@index([ownerAgentSubject, createdAt], map: "AdvancedInvestmentReturnProjectionResult_ownerAgentSubject_crea")
  @@index([projectionId, createdAt], map: "AdvancedInvestmentReturnProjectionResult_projectionId_createdAt")
}

model AdvancedInvestmentReturnDependency {
  id                String   @id @default(cuid())
  projectionId      String
  ownerAgentSubject String
  upstreamArtifact  String
  dependencyType    String
  versionUsed       String
  qualification     String
  detail            Json
  createdAt         DateTime @default(now())

  projection AdvancedInvestmentReturnProjection @relation(fields: [projectionId], references: [id], onDelete: Restrict)

  @@unique([projectionId, upstreamArtifact, dependencyType], map: "AdvancedInvestmentReturnDependency_projectionId_upstreamArtifac")
  @@index([ownerAgentSubject, projectionId], map: "AdvancedInvestmentReturnDependency_ownerAgentSubject_projection")
}

model AdvancedInvestmentReturnAuditEvent {
  id                String   @id @default(cuid())
  projectionId      String
  ownerAgentSubject String
  eventType         String
  eventFingerprint  String   @unique
  createdAt         DateTime @default(now())

  projection AdvancedInvestmentReturnProjection @relation(fields: [projectionId], references: [id], onDelete: Restrict)

  @@index([projectionId, createdAt])
  @@index([ownerAgentSubject, createdAt], map: "AdvancedInvestmentReturnAuditEvent_ownerAgentSubject_createdAt_")
}

