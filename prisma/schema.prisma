model PropertyGeographicRelationship {
  id                 String                             @id @default(cuid())
  propertyId         String
  geographicObjectId String
  relationshipType   GeographicPropertyRelationshipType
  sourceId           String?
  confidence         GeographicConfidence               @default(MEDIUM)
  assignmentMethod   GeographicDerivationMethod         @default(MANUAL_REVIEW)
  effectiveDate      DateTime?
  expirationDate     DateTime?
  lifecycleStatus    GeographicLifecycleStatus          @default(ACTIVE)
  createdAt          DateTime                           @default(now())
