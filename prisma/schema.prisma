  searchEligible     Boolean  @default(false)
  mapEligible        Boolean  @default(false)
  publicPageEligible Boolean  @default(false)
  indexingEligible   Boolean  @default(false)
  propertyEnrichment Boolean  @default(false)
  marketAnalytics    Boolean  @default(false)
