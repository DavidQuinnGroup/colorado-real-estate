# Real Estate Intelligence Engine local environment template
#
# Copy this file to .env.local and replace placeholders with the active
# provider values. Never commit .env, .env.local, or real secrets.

# Supabase: replace these together from the same active project.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-jwt>"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<supabase-publishable-key>"
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-jwt>"
DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:6543/postgres?schema=public&pgbouncer=true&connection_limit=1"

# Admin route protection.
REIE_ADMIN_API_KEY="<local-admin-key>"
ADMIN_API_KEY="<local-admin-key>"

# Local infrastructure.
REDIS_URL="redis://localhost:6379"
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8109"
TYPESENSE_PROTOCOL="http"
TYPESENSE_API_KEY="<typesense-api-key>"

# Public app URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
PUBLIC_SITE_URL="http://localhost:3000"

# MLS Grid credentials.
MLS_GRID_BASE_URL="<mls-grid-base-url>"
MLS_GRID_TOKEN="<mls-grid-bearer-token>"
MLS_API_URL="<legacy-mls-api-url-fallback>"
MLS_API_KEY="<legacy-mls-api-key-fallback>"
MLS_GRID_INCLUDE_MEDIA="true"
MLS_GRID_MIN_DELAY_MS="250"

# Email delivery.
RESEND_API_KEY="<resend-api-key>"
RESEND_FROM_EMAIL="David Quinn Group <alerts@example.com>"
RESEND_REPLY_TO_EMAIL="reply@example.com"
# Property inquiry notifications use PROPERTY_INQUIRY_NOTIFY_TO first,
# then REIE_INTERNAL_EMAIL as the fallback internal recipient.
PROPERTY_INQUIRY_NOTIFY_TO="internal-property-inquiries@example.com"
REIE_INTERNAL_EMAIL="internal@example.com"
# Set to true only for non-sending local/staging validation of high-priority
# property inquiry notification paths. Leave false or unset for launch.
PROPERTY_INQUIRY_NOTIFICATION_DRY_RUN="false"

# Optional integrations.
MAPBOX_ACCESS_TOKEN="<mapbox-access-token>"
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="<mapbox-access-token>"
OPENAI_API_KEY="<openai-api-key>"
SLACK_WEBHOOK_URL="<slack-webhook-url>"
GOOGLE_INDEXING_ACCESS_TOKEN="<google-indexing-access-token>"
VAULT_ENCRYPTION_KEY="<vault-encryption-key>"

# Optional runtime controls.
NODE_ENV="development"
REIE_REDIS_RETRY_MODE="fail-fast"
REIE_WORKERS="mls,mls-page,alert"
