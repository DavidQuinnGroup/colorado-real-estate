{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmitOnError": true
  },
  "include": [
    "workers/**/*.ts",
    "lib/mls/**/*.ts",
    "lib/queue/**/*.ts",
    "lib/alerts/processAlertQueue.ts",
    "lib/email/sendEmail.ts",
    "lib/email/sendPropertyInquiryNotification.ts",
    "lib/prisma.ts",
    "lib/typesense/**/*.ts",
    "scripts/checkSupabase.ts",
    "scripts/createTypesenseCollection.ts",
    "scripts/fetchMLS.ts",
    "scripts/index.ts",
    "scripts/initTypesense.ts",
    "scripts/mlsSync.ts",
    "scripts/quickSeed.ts",
    "scripts/queueDashboard.ts",
    "scripts/queueMaintenance.ts",
    "scripts/propertyInquirySmoke.ts",
    "scripts/propertyInquiryNotificationCheck.ts",
    "scripts/propertyInquiryNotificationReadiness.ts",
    "scripts/runAlerts.ts",
    "scripts/runCRM.ts",
    "scripts/seedTestProperties.ts",
    "scripts/sendDigest.ts"
  ],
  "exclude": [
    "node_modules",
    "app",
    "components",
    ".next",
    "dist"
  ]
}
